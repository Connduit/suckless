setws()
{
    if [ "$#" -ne 1 ]; then
        gr=$(pwd)
        export GIT_ROOT="$gr"
        export ROOT_OFFSET="$gr"
        echo "GIT_ROOT and ROOT_OFFSET set to: $GIT_ROOT"
        return
    fi

    export GIT_ROOT="$1"
    export ROOT_OFFSET="$1"

    echo "GIT_ROOT and ROOT_OFFSET set to: $GIT_ROOT"
}
